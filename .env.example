# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# App URL used in links (optional)
# APP_URL=https://erp.yourdomain.com

# ---- Automatic backups (optional) ----
# Set a folder on the machine running the app and every business gets a nightly
# JSON backup written there (first run after 02:00 Karachi time, once per day).
# Unset = feature off; the Settings -> Download full backup button still works.
# BACKUP_DIR=/var/backups/faberp

# ---- Owner-controlled registration verification ----
# Verification codes are delivered to the platform owner's secure IN-APP mailbox
# (Settings -> Owner Mailbox). No third-party email service is required.
#
# OPTIONAL real email delivery (our own SMTP transport via nodemailer):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM="AfridiTech ERP <youraddress@gmail.com>"
# OWNER_VERIFY_EMAIL=inamuafridi300@gmail.com
